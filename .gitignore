# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez


# Dados e chaves de teste locais (NUNCA versionar chaves, mesmo de teste)
/dev/
/net/
*.key
*.seed
/node_modules/
/apps/*/priv/static/assets/

# Python (gerador de diagramas)
__pycache__/
*.pyc

# Redes de teste locais (chaves e genesis gerados por mix brdc.keygen/brdc.genesis)
/net/
/dev-net/
/testnet/

# Diretórios temporários dos testes (ExUnit tmp_dir)
tmp/

# laboratório Docker: chaves de teste, .env e o compose gerado (mix brdc.compose.init)
/compose/
